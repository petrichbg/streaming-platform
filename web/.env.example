# Copy to .env.local. Values prefixed NEXT_PUBLIC_ are embedded in the
# browser bundle by design -- never put secrets here.

# Base URL of the NestJS API. When other devices on the LAN use this client,
# point it at the server's LAN address (e.g. http://192.168.1.50:3000) and add
# that origin to WEB_ORIGIN in backend/.env, or CORS will block the requests.
NEXT_PUBLIC_API_URL=http://localhost:3000
