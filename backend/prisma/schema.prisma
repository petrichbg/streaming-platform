generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  isAdmin      Boolean   @default(false)
  sessionVersion Int     @default(0)
  createdAt    DateTime  @default(now())
  profiles     Profile[]
}

model Profile {
  id            String          @id @default(uuid())
  user          User            @relation(fields: [userId], references: [id])
  userId        String
  name          String
  isKid         Boolean         @default(false)
  pinHash       String?
  // Content above this rating is hidden/blocked for this profile, e.g. "PG-13".
  maxRating     String?
  createdAt     DateTime        @default(now())
  watchProgress WatchProgress[]
  watchlist     WatchlistItem[]

  @@unique([userId, name])
}

enum TitleType {
  MOVIE
  SERIES
}

model Title {
  id            String          @id @default(uuid())
  type          TitleType
  name          String
  overview      String?
  releaseYear   Int?
  rating        String?
  genres        String[]
  posterPath    String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  episodes      Episode[]
  mediaFiles    MediaFile[]
  watchProgress WatchProgress[]
  watchlist     WatchlistItem[]

  // Used by the media importer (src/media/media-scanner.service.ts) to
  // upsert on (name, type) instead of creating duplicate titles per scan.
  @@unique([name, type])
}

model Episode {
  id            String          @id @default(uuid())
  title         Title           @relation(fields: [titleId], references: [id])
  titleId       String
  seasonNumber  Int
  episodeNumber Int
  name          String?
  overview      String?
  mediaFiles    MediaFile[]
  watchProgress WatchProgress[]

  @@unique([titleId, seasonNumber, episodeNumber])
}

model MediaFile {
  id             String         @id @default(uuid())
  title          Title?         @relation(fields: [titleId], references: [id])
  titleId        String?
  episode        Episode?       @relation(fields: [episodeId], references: [id])
  episodeId      String?
  // Path relative to MEDIA_ROOT (see backend/.env.example).
  sourcePath     String
  container      String?
  videoCodec     String?
  // e.g. [{ "index": 1, "codec": "aac", "language": "bg" }]
  audioTracks    Json?
  // e.g. [{ "index": 2, "codec": "subrip", "language": "en", "forced": false }]
  subtitleTracks Json?
  durationSec    Int?
  importedAt     DateTime       @default(now())
  transcodeJobs  TranscodeJob[]
}

enum TranscodeStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

model TranscodeJob {
  id           String           @id @default(uuid())
  mediaFile    MediaFile        @relation(fields: [mediaFileId], references: [id])
  mediaFileId  String
  // h264_amf | hevc_amf | libx264 (CPU fallback) — see config/configuration.ts
  encoder      String
  targetHeight Int
  status       TranscodeStatus  @default(QUEUED)
  outputPath   String?
  error        String?
  createdAt    DateTime         @default(now())
  startedAt    DateTime?
  finishedAt   DateTime?
}

model WatchProgress {
  id          String    @id @default(uuid())
  profile     Profile   @relation(fields: [profileId], references: [id])
  profileId   String
  title       Title?    @relation(fields: [titleId], references: [id])
  titleId     String?
  episode     Episode?  @relation(fields: [episodeId], references: [id])
  episodeId   String?
  positionSec Int
  durationSec Int?
  updatedAt   DateTime  @updatedAt

  @@unique([profileId, titleId, episodeId])
}

model WatchlistItem {
  id        String   @id @default(uuid())
  profile   Profile  @relation(fields: [profileId], references: [id])
  profileId String
  title     Title    @relation(fields: [titleId], references: [id])
  titleId   String
  addedAt   DateTime @default(now())

  @@unique([profileId, titleId])
}
