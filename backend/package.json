{
  "name": "streaming-platform-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "lint": "eslint \"src/**/*.ts\" \"scripts/**/*.{cjs,mjs}\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "test:security": "node ../scripts/check-security.mjs",
    "test:integration": "powershell -ExecutionPolicy Bypass -File ../scripts/integration-test.ps1"
    ,"test:unit": "vitest run"
    ,"test": "npm run test:unit"
    ,"typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.2.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.0",
    "@prisma/client": "^5.19.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.12.0",
    "ioredis": "^5.4.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "prisma": "^5.19.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
