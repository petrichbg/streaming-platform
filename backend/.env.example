# Copy to .env and fill in real values. Never commit .env itself.
# POSTGRES_/REDIS_ credentials must match the root ../.env used by docker-compose.yml.

PORT=3000

DATABASE_URL=postgresql://streaming:changeme@localhost:5432/streaming
REDIS_URL=redis://:changeme@localhost:6379

# Secret used to sign JWT session tokens. Generate a real random value, e.g.
# `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`.
# No default is provided on purpose — the app refuses to start without it.
JWT_SECRET=changeme-generate-a-real-random-secret
JWT_EXPIRES_IN=7d

# Origins allowed to call this API from a browser. Comma-separated. Add the
# LAN address other devices will use, e.g.
# http://localhost:3001,http://192.168.1.50:3001
WEB_ORIGIN=http://localhost:3001

# TMDB metadata enrichment. Get a key at themoviedb.org -> Settings -> API and
# copy the "API Read Access Token" (a long JWT), NOT the short api_key.
# Leave blank to disable enrichment entirely.
TMDB_ACCESS_TOKEN=
# Language for titles/overviews. TMDB falls back to the original when a
# translation is missing.
TMDB_LANGUAGE=bg-BG
# Whose certification lands in Title.rating. TMDB seldom carries Bulgarian
# certifications, and catalog/ratings.ts implements the US ladders (G..NC-17,
# TV-Y..TV-MA), so changing this will likely break parental controls.
TMDB_CERTIFICATION_COUNTRY=US
# Posters are downloaded here so LAN devices never need to reach image.tmdb.org.
POSTER_ROOT=D:/media-posters

# Absolute path to your media library on this machine.
MEDIA_ROOT=D:/media

# Absolute path where HLS transcode output is written. Kept separate from
# MEDIA_ROOT so renditions never mix with your original files.
TRANSCODE_OUTPUT_ROOT=D:/media-transcoded

# From the GPU capacity test (RX 7900 XTX, 1080p 10-bit source, 6M bitrate):
# all sessions stayed OK-realtime (>=1.0x) up to 6 concurrent for both
# encoders, with large headroom (5.3x/4.5x at 6 concurrent). 6 is the tested
# ceiling, not a hard max — raise it and retest if you need more, see
# ../scripts/gpu-test/gpu-test-results.csv and ../docs/ARCHITECTURE.md.
TRANSCODE_MAX_CONCURRENT_H264_AMF=6
TRANSCODE_MAX_CONCURRENT_HEVC_AMF=6
